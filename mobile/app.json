{
  "expo": {
    "name": "Elladria",
    "slug": "elladria-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elladria.demo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131b2e",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.elladria.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ],
    "scheme": "elladria",
    "extra": {
      "eas": {
        "projectId": "07369ef0-e90a-4656-8388-a5b9fbfd1557"
      }
    },
    "owner": "it-elladria"
  }
}
