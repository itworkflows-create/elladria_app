{
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_BACKEND": "supabase",
        "ELLADRIA_RELEASE": "1"
      },
      "autoIncrement": true
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_BACKEND": "supabase",
        "ELLADRIA_RELEASE": "1"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
